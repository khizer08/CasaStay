<% layout('/layouts/boilerplate') -%>
<body>
  <div class="row mt-3">
    <div
      class="col-12 col-lg-8 col-md-10 col-sm-12 offset-lg-3 offset-md-2 offset-sm-0"
    >
      <h3>Create A New Listing</h3>
      <form
        method="POST"
        action="/listings"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
      >
        <div class="col-12 col-lg-8 col-md-8 col-sm-8 mb-3 mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            name="listing[title]"
            placeholder="enter title"
            type="text"
            class="form-control"
            required
          />
          <div class="valid-feedback">Looks Good!</div>
          <div class="invalid-feedback">Title Cannot Be Empty</div>
        </div>

        <div class="col-12 col-lg-8 col-md-8 col-sm-8 mb-3 mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            name="listing[description]"
            placeholder="enter description"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">Enter The Description</div>
        </div>

        <div class="col-12 col-lg-8 col-md-8 col-sm-8 mb-3 mb-3">
          <label for="image" class="form-label">Upload Listing Image</label>
          <input
            name="listing[image]"
            type="file"
            class="form-control"
            required
          />
        </div>

        <div class="row">
          <div class="mb-3 col-12 col-md-4 col-sm-4">
            <label for="price" class="form-label">Price</label>
            <input
              name="listing[price]"
              placeholder="enter price"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Enter Valid Price</div>
          </div>

          <div class="mb-3 col-12 col-md-4 col-sm-4">
            <label for="country" class="form-label">Country</label>
            <input
              name="listing[country]"
              placeholder="enter country"
              type="text"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Enter Valid Country Name</div>
          </div>
        </div>

        <div class="col-12 col-lg-8 col-md-8 col-sm-8 mb-3 mb-3">
          <label for="category" class="form-label">Category</label>
          <select name="listing[category]" class="form-select">
            <option value="">Select Category</option>
            <option value="Trending">Trending</option>
            <option value="Rooms">Rooms</option>
            <option value="Iconic Cities">Iconic Cities</option>
            <option value="Mountains">Mountains</option>
            <option value="Castles">Castles</option>
            <option value="Amazing Pools">Amazing Pools</option>
            <option value="Camping">Camping</option>
            <option value="Farms">Farms</option>
            <option value="Arctic">Arctic</option>
            <option value="Domes">Domes</option>
            <option value="Boats">Boats</option>
          </select>
        </div>

        <div class="col-12 col-lg-8 col-md-8 col-sm-8 mb-3 mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            name="listing[location]"
            placeholder="enter location"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Enter Valid Location</div>
        </div>

        <button class="btn btn-dark add-btn mt-2">Add</button>
      </form>
    </div>
  </div>
</body>
