<% layout('/layouts/boilerplate') -%>
<div class="row mt-3">
    <div class="col-12  col-lg-6 col-md-8 col-sm-8 offset-lg-3 offset-md-2 offset-sm-2">
        <h3><%= listing.title %></h3>
    </div>

    <div class="card col-12  col-lg-6 col-md-8 col-sm-8 offset-lg-3 offset-md-2 offset-sm-2  show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing_image">
        <div class="card-body">
            <p class="card-text">
                Owned By <b><i><%= listing.owner.username %></i></b>
            </p>
            <p class="card-text">
                <%= listing.description %><br>
            </p>
            <p class="card-text price">
                &#8377; <%= listing.price.toLocaleString("en-IN") %>/night

                <!-- reserve button  -->
                <% if (currUser && !listing.owner._id.equals(currUser._id)) { %>

                    <% if (userBooking) { %>

                        <button class="btn btn-secondary ms-3" disabled>
                            Already Booked
                        </button>

                    <% } else if (activeBooking) { %>

                            <button class="btn btn-secondary ms-3" disabled>
                                Currently Booked
                            </button>

                        <% } else { %>

                                <button
                                    type="button"
                                    class="btn btn-dark ms-3"
                                    onclick="openBookingModal()"
                                >
                                    Reserve
                                </button>

                            <% } %>

                <% } %>
            </p>
            
            <p class="card-text">
                <%= listing.location %><br>
            </p>
            <p class="card-text">
                <%= listing.country %><br>
            </p>
        </div>
    </div>

    <!--map section-->
    <% if (listing.lat && listing.lng) { %>
    <div class="col-12  col-lg-6 col-md-8 col-sm-8 offset-lg-3 offset-md-2 mt-4 mb-4">
        <h4>Where you'll be</h4>
        <div id="map" data-lat="<%= listing.lat %>" data-lng="<%= listing.lng %>"></div>
    </div>
    <% } %>


    <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit"
           class="btn btn-dark offset-lg-3 offset-md-2 offset-sm-1 edit-btn">
            Edit
        </a>

        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark offset-3">Delete</button>
        </form>
    </div>
    <% } %>

    <div class="col-9 offset-lg-3 offset-md-2 offset-sm-1 mb-3">

        <div class="col-12 col-sm-12 col-md-10 col-lg-8 ">
            <hr>
        </div>


        <% if (currUser) { %>
        <h4>Leave a Review</h4>
        <form method="POST"
              action="/listings/<%= listing.id %>/reviews"
              novalidate
              class="needs-validation">

            <div class="mt-3">
                <label class="form-label">Rating</label>
                <fieldset class="starability-slot">
                    <input type="radio" class="input-no-rate" name="review[rating]" value="1" checked />
                    <input type="radio" id="rate1" name="review[rating]" value="1" />
                    <label for="rate1">1 star</label>
                    <input type="radio" id="rate2" name="review[rating]" value="2" />
                    <label for="rate2">2 stars</label>
                    <input type="radio" id="rate3" name="review[rating]" value="3" />
                    <label for="rate3">3 stars</label>
                    <input type="radio" id="rate4" name="review[rating]" value="4" />
                    <label for="rate4">4 stars</label>
                    <input type="radio" id="rate5" name="review[rating]" value="5" />
                    <label for="rate5">5 stars</label>
                </fieldset>
            </div>

            <div class="col-12 col-lg-6 col-md-8 col-sm-8 mb-2 ">
                <label class="form-label">Comment</label>
                <textarea name="review[comment]" class="form-control" required></textarea>
                <div class="invalid-feedback">
                    Please add some comments for review
                </div>
            </div>

            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <div class="col-12 col-sm-12 col-md-10 col-lg-8 ">
            <hr>
        </div>
        <% } %>
        
        <% if (listing.reviews.length > 0) { %>

            <div class="row mb-2">
                <div class="col-12">
                    <p><b>All Reviews</b></p>
                </div>
            </div>

            <div class="row review-cards g-2">
                <% for (let review of listing.reviews) { %>
                    <div class="col-12 col-sm-4 col-md-4 col-lg-3">
                        <div class="card review-delete-card-body h-100">
                            <div class="review-card-body">
                                <h5>@<%= review.author.username %></h5>
                                <p class="starability-result" data-rating="<%= review.rating %>"></p>
                                <p><%= review.comment %></p>
                            </div>

                            <form method="POST"
                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="btn review-delete-btn btn-sm btn-dark mb-2 ms-2">Delete</button>
                            </form>
                        </div>
                    </div>

                <% } %>
            </div>

        <% } %>


    </div>

    <!-- reservation popup -->
    <div id="bookingModal" class="booking-modal">
        <div class="booking-content">
            <h5>Book this place</h5>

            <form action="/listings/<%= listing._id %>/book" method="POST">
                <div class="mb-2">
                    <label>Check-in</label>
                    <input type="date" name="checkIn" id="checkIn" class="form-control" required>
                </div>

                <div class="mb-2">
                    <label>Check-out</label>
                    <input type="date" name="checkOut" id="checkOut" class="form-control" required>
                </div>

                <hr>

                <div id="priceDetails">
                    <p>Nights: <span id="nights">0</span></p>
                    <p>Subtotal: ₹<span id="subtotal">0</span></p>
                    <p>GST (18%): ₹<span id="gst">0</span></p>
                    <h6>Total: ₹<span id="total">0</span></h6>
                </div>

                <button class="btn btn-dark w-100 mt-2">
                    Pay
                </button>
            </form>

            <button class="close-btn" onclick="closeBookingModal()">×</button>
        </div>
    </div>
    <!-- ends here -->
</div>
<script src="/js/booking.js"></script>
