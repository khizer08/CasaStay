<!DOCTYPE html>
<html>
  <body>
    <div style="<%= otpStyle.container %>">

      <h2 style="<%= otpStyle.heading %>">
        Verify your email, <%= username.toUpperCase() %> &#128274;
      </h2>

      <p>Your One-Time Password (OTP) is:</p>

      <div style="<%= otpStyle.otpText %>">
        <strong><%= otp %></strong>
      </div>

      <p>This OTP will expire in <strong>1 minute</strong>.</p>

      <p>
        If you didn’t create a CasaStay account, please ignore this email.
      </p>

      <hr />

      <p style="<%= otpStyle.footer %>">
        &mdash; Team CasaStay
      </p>

    </div>
  </body>
</html>