<!DOCTYPE html>
<html>
  <body>
    <div style="<%= mailStyle.cancellationConfirmContainerStyle %>">
      <h2 style="<%= mailStyle.cancellationConfirmHeadingStyle %>">
        Booking Cancelled ❌
      </h2>

      <p>Hi <b><%= username %></b>,</p>

      <p>
        Your Booking For <b><%= listingTitle %></b> Has Been Successfully
        Cancelled.
      </p>

      <p><b>Check-In:</b> <%= checkIn %></p>
      <p><b>Check-Out:</b> <%= checkOut %></p>
      <p><b>Total Paid:</b> ₹<%= totalAmount %></p>

      <p>Your Refund Will Be Processed Within <b>24–48 Hours</b>.</p>

      <hr />
      <p style="<%= mailStyle.footer %>">
        &mdash; <strong>Team CasaStay</strong>
      </p>
    </div>
  </body>
</html>
