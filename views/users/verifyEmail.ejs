<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
  <div
    class="col-12 col-lg-6 col-md-8 col-sm-8 offset-lg-3 offset-md-2 offset-sm-2"
  >
    <h3>Verify Your Email</h3>

    <div class="col-12 col-lg-8 col-md-10 col-sm-10 mb-3 mb-3">
      <form
        action="/verify-email"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label for="otp" class="form-label">Enter OTP</label>
          <input
            name="otp"
            type="text"
            class="form-control text-center"
            placeholder="Enter 6-digit OTP"
            maxlength="6"
            pattern="[0-9]{6}"
            required
          />
          <div class="invalid-feedback">
            Please Enter The 6-Digit OTP Sent To Your Email.
          </div>
        </div>

        <button class="btn btn-success w-100 mb-2">Verify Email</button>
      </form>

      <p class="text-center mt-3" id="resendMsg">
        Resend OTP In <span id="timer"></span>
      </p>

      <form action="/resend-otp" method="POST" class="text-center">
        <button id="resendBtn" class="btn btn-outline-secondary" disabled>
          Resend OTP
        </button>
      </form>

      <script>
        window.otpExpiry = <%= otpExpiry || 0 %>;
        console.log("OTP Expiry:", window.otpExpiry);
      </script>
      <script src="/js/otpResend.js"></script>
    </div>
  </div>
</div>
