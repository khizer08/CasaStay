<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
  <div
    class="col-12 col-lg-6 col-md-8 col-sm-8 offset-lg-3 offset-md-2 offset-sm-2"
  >
    <h3>Forgot Password</h3>
    <div class="col-12 col-lg-8 col-md-10 col-sm-10 mb-3 mb-3">
      <form action="/forgot-password" method="POST">
        <div class="mb-3">
          <label class="form-label">Registered Email</label>
          <input
            type="email"
            name="email"
            class="form-control"
            placeholder="Enter Registered Email"
            required
          />
        </div>

        <button class="btn btn-success">Send OTP</button>
      </form>
    </div>
  </div>
</div>
