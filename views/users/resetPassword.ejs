<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
  <div
    class="col-12 col-lg-6 col-md-8 col-sm-8 offset-lg-3 offset-md-2 offset-sm-2"
  >
    <h3>Reset Password</h3>

    <div class="col-12 col-lg-8 col-md-10 col-sm-10 mb-3 mb-3">
      <form
        action="/reset-password"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label class="form-label">Enter OTP</label>
          <input
            type="text"
            name="otp"
            class="form-control text-center"
            maxlength="6"
            pattern="[0-9]{6}"
            required
          />
        </div>

        <div class="mb-3">
          <label class="form-label">New Password</label>
          <input
            type="password"
            name="password"
            class="form-control"
            required
          />
        </div>

        <button class="btn btn-success w-100 mb-2">Reset Password</button>
      </form>

      <p class="text-center mt-3" id="resendMsg">
        Resend OTP In <span id="timer"></span>
      </p>

      <form action="/resend-reset-otp" method="POST" class="text-center">
        <button id="resendBtn" class="btn btn-outline-secondary" disabled>
          Resend OTP
        </button>
      </form>

      <script>
        window.otpExpiry = <%= otpExpiry || 0 %>;
      </script>

      <script src="/js/otpResend.js"></script>
    </div>
  </div>
</div>
