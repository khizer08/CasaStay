<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
  <h1 class="col-12 col-sm-10 col-md-8 col-lg-7 mx-auto">Reset Password</h1>

  <div class="col-12 col-sm-10 col-md-8 col-lg-7 mx-auto">
    <form
      action="/reset-password"
      method="POST"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3">
        <label class="form-label">Enter OTP</label>
        <input
          type="text"
          name="otp"
          class="form-control text-center"
          maxlength="6"
          pattern="[0-9]{6}"
          required
        />
      </div>

      <div class="mb-3">
        <label class="form-label">New Password</label>
        <input type="password" name="password" class="form-control" required />
      </div>

      <button class="btn btn-success w-100 mb-2">Reset Password</button>
    </form>

    <p class="text-center mt-3" id="resendMsg">
      Resend OTP in <span id="timer"></span>
    </p>

    <form action="/resend-reset-otp" method="POST" class="text-center">
      <button id="resendBtn" class="btn btn-outline-secondary" disabled>
        Resend OTP
      </button>
    </form>

    <script>
      window.otpExpiry = <%= otpExpiry || 0 %>;
    </script>

    <script src="/js/otpResend.js"></script>
  </div>
</div>
