<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
  <h1 class="col-12 col-sm-10 col-md-8 col-lg-7 mx-auto">
    Enter Cancellation OTP
  </h1>

  <div class="col-12 col-sm-10 col-md-8 col-lg-7 mx-auto">
    <form
      action="/bookings/<%= booking._id %>/verify-cancel"
      method="POST"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3">
        <label for="otp" class="form-label">Enter OTP</label>
        <input
          name="otp"
          type="text"
          id="otp"
          class="form-control text-center"
          placeholder="Enter 6-digit OTP"
          maxlength="6"
          pattern="[0-9]{6}"
          inputmode="numeric"
          required
        />
        <div class="invalid-feedback">
          Please enter the 6-digit OTP sent to your email.
        </div>
      </div>

      <button class="btn btn-danger w-100 mb-2">Confirm Cancellation</button>
    </form>

    <p class="text-center mt-3" id="resendMsg">
      Resend OTP in <span id="timer"></span>
    </p>

    <form
      action="/bookings/<%= booking._id %>/send-cancel-otp"
      method="POST"
      class="text-center"
    >
      <button
        id="resendBtn"
        type="submit"
        class="btn btn-outline-secondary"
        disabled
      >
        Resend OTP
      </button>
    </form>

    <script>
      window.otpExpiry = <%= otpExpiry || 0 %>;
    </script>

    <script src="/js/otpResend.js"></script>
  </div>
</div>
