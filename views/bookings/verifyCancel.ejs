<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
  <div
    class="col-12 col-lg-6 col-md-8 col-sm-8 offset-lg-3 offset-md-2 offset-sm-2"
  >
    <h3>Enter Cancellation OTP</h3>

    <div class="col-12 col-lg-8 col-md-10 col-sm-10 mb-3 mb-3">
      <form
        action="/bookings/<%= booking._id %>/verify-cancel"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label for="otp" class="form-label">Enter OTP</label>
          <input
            name="otp"
            type="text"
            id="otp"
            class="form-control text-center"
            placeholder="Enter 6-digit OTP"
            maxlength="6"
            pattern="[0-9]{6}"
            inputmode="numeric"
            required
          />
          <div class="invalid-feedback">
            Please Enter The 6-Digit OTP Sent To Your Email.
          </div>
        </div>

        <button class="btn btn-danger w-100 mb-2">Confirm Cancellation</button>
      </form>

      <p class="text-center mt-3" id="resendMsg">
        Resend OTP In <span id="timer"></span>
      </p>

      <form
        action="/bookings/<%= booking._id %>/send-cancel-otp"
        method="POST"
        class="text-center"
      >
        <button
          id="resendBtn"
          type="submit"
          class="btn btn-outline-secondary"
          disabled
        >
          Resend OTP
        </button>
      </form>

      <!-- Attempts Left -->
      <% if (typeof cancelResendAttemptsLeft !== "undefined" && cancelResendAttemptsLeft !== null) { %>
        <p class="text-danger text-center mt-2">
          Resend Attempts Left: <%= cancelResendAttemptsLeft %>
        </p>
      <% } %>
      <!--ends here-->

      <script>
        window.otpExpiry = <%= otpExpiry || 0 %>;
      </script>

      <script src="/js/otpResend.js"></script>
    </div>
  </div>
</div>
