<% layout('/layouts/boilerplate') -%>

<div class="col-12 col-lg-8 offset-lg-2">
  <div class="container mt-4 text-center">
    <h3>Payment Summary</h3>

    <div class="card p-4 mt-4">
      <h5><%= booking.listing.title %></h5>

      <p>Check-In: <%= booking.checkIn.toDateString() %></p>
      <p>Check-Out: <%= booking.checkOut.toDateString() %></p>
      <p>Nights: <%= booking.nights %></p>

      <hr />

      <p>Price Per Night: ₹<%= booking.pricePerNight %></p>
      <p>GST (18%): ₹<%= booking.taxes %></p>

      <h5>Total: ₹<%= booking.totalAmount %></h5>

      <!-- Razorpay Button -->
      <button
        id="pay-btn"
        class="btn btn-dark mt-3"
        data-key="<%= razorpayKey %>"
        data-amount="<%= booking.totalAmount * 100 %>"
        data-order="<%= orderId %>"
        data-booking="<%= booking._id %>"
      >
        Confirm Payment
      </button>
    </div>
  </div>
</div>

<!-- Razorpay Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/razorpayPayment.js"></script>
