<% layout('/layouts/boilerplate') -%>

<div class="container mt-5 text-center">
  <h2>&#127881; Booking Confirmed!</h2>

  <div class="card p-4 mt-4">
    <h5><%= booking.listing.title %></h5>

    <p>Check-in: <%= booking.checkIn.toDateString() %></p>
    <p>Check-out: <%= booking.checkOut.toDateString() %></p>

    <h5>Total Paid: ₹<%= booking.totalAmount %></h5>
  </div>

  <a href="/listings" class="btn btn-dark mt-3"> Explore More </a>
</div>
